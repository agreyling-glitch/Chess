{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ironwood-chess",
  "compatibility_date": "2026-09-19",
  "main": "src/wrangler-worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": "./.wrangler-assets",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
