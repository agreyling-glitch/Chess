{{ printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ .Site.BaseURL }}</loc></url>
  <url><loc>{{ "play/" | absURL }}</loc></url>
  <url><loc>{{ "open-source-notices.html" | absURL }}</loc></url>
  {{- range where .Site.Pages "Kind" "section" }}
  <url><loc>{{ .Permalink }}</loc>{{ with .Lastmod }}<lastmod>{{ .Format "2006-01-02" }}</lastmod>{{ end }}</url>
  {{- end }}
  {{- range .Site.RegularPages }}
  <url><loc>{{ .Permalink }}</loc>{{ with .Lastmod }}<lastmod>{{ .Format "2006-01-02" }}</lastmod>{{ end }}</url>
  {{- end }}
</urlset>
