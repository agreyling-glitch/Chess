{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ironwood-companion-releases",
  "main": "worker.js",
  "compatibility_date": "2026-10-21",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern": "companion-releases.ironwoodchess.com", "custom_domain": true}],
  "r2_buckets": [{"binding": "RELEASES", "bucket_name": "ironwood-companion-private"}],
  "vars": {"PUBLIC_WINDOWS_RELEASES": "1"},
  "observability": {"enabled": false}
}
