{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ironwood Companion configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "listen",
    "allowed_origins",
    "token_file"
  ],
  "properties": {
    "listen": {
      "type": "string",
      "description": "IP socket address, for example 127.0.0.1:8790. Hostnames are not accepted."
    },
    "allowed_origins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https?://[^/?#@]+$"
      }
    },
    "token_file": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute path or path relative to this configuration file. Contents: at least 32 ASCII letters/digits."
    },
    "allow_non_loopback": {
      "type": "boolean",
      "default": false,
      "description": "Required for binding inside Docker. Does not enable TLS."
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_connections": {
          "type": "integer",
          "default": 16,
          "minimum": 1,
          "maximum": 256
        },
        "max_pending_tickets": {
          "type": "integer",
          "default": 64,
          "minimum": 1,
          "maximum": 4096
        },
        "requests_per_minute": {
          "type": "integer",
          "default": 240,
          "minimum": 1,
          "maximum": 10000
        },
        "max_request_bytes": {
          "type": "integer",
          "default": 4096,
          "minimum": 1,
          "maximum": 65536
        },
        "request_timeout_seconds": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "maximum": 300
        },
        "authentication_timeout_seconds": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 300
        },
        "idle_timeout_seconds": {
          "type": "integer",
          "default": 30,
          "minimum": 1,
          "maximum": 300
        },
        "shutdown_timeout_seconds": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 300
        }
      }
    },
    "engines": {
      "type": "array",
      "maxItems": 64,
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "executable"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "executable": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "options": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "default": {}
          }
        }
      }
    },
    "engine_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_processes": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "maximum": 32
        },
        "handshake_ms": {
          "type": "integer",
          "default": 3000,
          "minimum": 100,
          "maximum": 10000
        },
        "stop_ms": {
          "type": "integer",
          "default": 1000,
          "minimum": 100,
          "maximum": 2000
        },
        "max_search_ms": {
          "type": "integer",
          "default": 300000,
          "minimum": 1000,
          "maximum": 3600000
        },
        "max_threads": {
          "type": "integer",
          "default": 8,
          "minimum": 1,
          "maximum": 256
        },
        "max_hash_mib": {
          "type": "integer",
          "default": 1024,
          "minimum": 1,
          "maximum": 65536
        }
      }
    },
    "archive": {
      "type": [
        "string",
        "null"
      ],
      "default": "archive/archive.sqlite3",
      "description": "Owner-local SQLite database, relative to config.json or absolute. Null disables the archive. Keep on local disk."
    },
    "tablebase_directories": {
      "type": "array",
      "maxItems": 16,
      "default": [],
      "items": {
        "type": "string"
      },
      "description": "Owner supplied Syzygy directories, relative to config.json or absolute. Read only, nonrecursive; no downloads."
    }
  }
}
